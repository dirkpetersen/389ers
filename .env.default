# =============================================================================
# 389ers — reference configuration
#
# Every setting the app reads, with its default and what it does. Copy the
# lines you need into your real environment file; this file is documentation
# and is never loaded automatically.
#
# Configuration is env-first: each setting below overrides the equivalent key
# in a YAML config, and config.yaml is optional. That is what allows a PaaS
# deployment to run from a git checkout, where a gitignored YAML file cannot
# travel with the code.
#
# Secrets: settings marked _FILE take a path instead of a value. Prefer them.
# Environment variables are readable via /proc/<pid>/environ, are inherited by
# every child process, and turn up in crash dumps; a 0600 file is not.
# =============================================================================


# --- Server ------------------------------------------------------------------

# Port to listen on.
PORT=8088

# Set to "production" to serve the built client from dist/client and to enable
# production warnings about unsafe defaults.
NODE_ENV=production

# Interface to bind. Defaults to 0.0.0.0, except under AUTH_MODE=local (see
# below) where it defaults to 127.0.0.1.
#BIND_HOST=0.0.0.0

# Signs session cookies. The shipped default is a known string, so anyone can
# forge a session with it — always set this in production.
#SESSION_SECRET_FILE=/path/to/session.secret
#SESSION_SECRET=

# Session lifetime in milliseconds. Default 3600000 (1 hour).
#SESSION_TIMEOUT=3600000

# JSON-lines record of every permission change.
#AUDIT_LOG=./permissions-changes.log


# --- Directory backend --------------------------------------------------------

#   ldap  Bind to 389 DS / OpenLDAP with a service account. Writable. (default)
#   ad    Bind to Active Directory. Writable, but gated — see AD section.
#   nss   Resolve via getent(1), following nsswitch.conf. READ-ONLY.
#
# ad is a separate backend rather than a flag on ldap because AD is not schema
# compatible: sAMAccountName logins, DN-based membership, objectClass=group,
# and a user RDN of the display name rather than the login.
DIRECTORY_BACKEND=ad

# Load an alternate YAML config (absolute, or relative to the repo root) so
# LDAP, AD, and NSS deployments can keep separate files. Optional; when unset
# config/config.yaml is used if present.
#CONFIG_FILE=config/config.ad.yaml


# --- Directory connection -----------------------------------------------------

# Use ldaps:// . Plain ldap:// sends the bind password in cleartext, and many
# DCs reject writes over it anyway when "LDAP server signing requirements" is
# set to Require signing (that is server policy — no app setting bypasses it).
LDAP_URL=ldaps://dc1.example.edu:636

# CA bundle used to verify the DC certificate.
#
# IMPORTANT: AD presents leaf + intermediate but NOT the root. OpenLDAP's CLI
# tools tolerate that partial chain; Node does not, and fails with
# UNABLE_TO_GET_ISSUER_CERT. The bundle must therefore also contain the root,
# which is published in the forest's Configuration NC at
#   CN=Certification Authorities,CN=Public Key Services,CN=Services,<configNC>
# Note the Configuration NC lives under the FOREST root, which may differ from
# your domain NC — read it from the RootDSE rather than assuming. `ldaps-init`
# does all of this and writes a working bundle.
LDAP_CA_CERT=/path/to/ldap-ca.pem

# Root of the directory.
LDAP_BASE_DN=DC=example,DC=edu

# Where to search for groups and users. On AD there is no ou=People — accounts
# are scattered across the OU tree — so USERS_BASE_DN is usually the domain
# root.
#
# GROUPS_BASE_DN is also the container NEW GROUPS ARE CREATED IN. The domain
# root is fine for read-only use but is the wrong target for writes; narrow it
# to the OU this app owns before enabling writes.
USERS_BASE_DN=DC=example,DC=edu
GROUPS_BASE_DN=OU=Groups,DC=example,DC=edu

# Service account used for lookups.
LDAP_BIND_DN=CN=svc-389ers,OU=Service Accounts,DC=example,DC=edu
LDAP_BIND_PASSWORD_FILE=/path/to/ldap-bind.pass
#LDAP_BIND_PASSWORD=

# Search filters and attributes. The defaults suit 389 DS; the AD backend
# supplies its own and ignores LDAP_LOGIN_ATTR.
#LDAP_USER_FILTER=(objectClass=person)
#LDAP_GROUP_FILTER=(objectClass=posixGroup)
#LDAP_LOGIN_ATTR=uid
#LDAP_TIMEOUT_MS=30000


# --- Login --------------------------------------------------------------------

#   password  Try the local admin account, then verify by binding to the
#             directory as the user. (default)
#   local     Trust the OS identity of the process owner, no login prompt. For
#             running the tool as yourself on a workstation already
#             authenticated via SSSD/Kerberos. Grants the app's identity to
#             anyone who can reach the port, so it binds to loopback by default
#             and is ONLY safe there.
AUTH_MODE=password

# Force the admin flag on under AUTH_MODE=local.
#LOCAL_ADMIN=false

# REQUIRE_LOGIN=ldaps hardens the site to directory-verified logins only. It
# suppresses BOTH the passwordless local-trust session AND the shared admin
# account below, so a successful LDAPS bind becomes the only way in.
#
# Because nothing remains to fall back to, a misconfiguration here does not
# degrade — it locks everyone out. The server validates the preconditions at
# startup and exits rather than serving a site nobody can enter: the URL must
# be ldaps://, and on the NSS backend either LDAP_UPN_SUFFIX or
# LDAP_BIND_DN_TEMPLATE must be set (NSS synthesises a placeholder uid=<name>
# DN that cannot be bound with).
REQUIRE_LOGIN=ldaps

# How a login name becomes a bindable identity, tried in this order:
#   1. LDAP_BIND_DN_TEMPLATE   e.g. uid={{login}},ou=People,DC=example,DC=edu
#   2. LDAP_UPN_SUFFIX         AD-style <login>@<suffix>
#   3. a DN lookup through the directory backend
LDAP_UPN_SUFFIX=example.edu
#LDAP_BIND_DN_TEMPLATE=

# Authenticate against a different URL than lookups use. Defaults to LDAP_URL.
#LDAP_AUTH_URL=

# Local admin account. Disabled entirely by REQUIRE_LOGIN=ldaps; leave unset
# there. The shipped default password is a known string.
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD_FILE=/path/to/admin.pass
#ADMIN_PASSWORD=


# --- Groups -------------------------------------------------------------------

# GID range allocated to new groups. Check the range is unused in your
# directory first:
#   ldapsearch ... "(&(objectClass=group)(gidNumber=*))" gidNumber
#GID_MIN=300000
#GID_MAX=400000

# Super-admin group. Members may create and delete groups; per-group rights
# otherwise come from managedBy. Defaults to cn=389ers-admins under the base
# DN — if that group does not exist, every session gets isAdmin=false and
# create/delete are refused with 403.
#
# NOT CONSULTED when the AD backend has writes enabled: the directory is then
# the authority and the app does not impose a second gate. Relevant to the
# ldap/nss backends, and to AD while read-only.
ADMIN_GROUP=CN=389ers-admins,OU=Groups,DC=example,DC=edu


# =============================================================================
# Active Directory backend (DIRECTORY_BACKEND=ad)
# =============================================================================

# Login attribute. AD has no `uid` unless RFC2307/IDMU is installed.
#AD_LOGIN_ATTRIBUTE=sAMAccountName

# groupType bitmask for new groups:
#   -2147483646  global security (default)
#   -2147483644  domain local security
#   -2147483640  universal security
#AD_GROUP_TYPE=-2147483646

# Extra constraint ANDed into every group lookup — a complete parenthesised
# LDAP filter. (gidNumber=*) restricts the app to POSIX-enabled groups, hiding
# the mail-enabled and security-only groups that make up most of a typical AD
# but mean nothing to a Unix system. Applied to exact-name lookups too, so an
# excluded group is not reachable by URL.
AD_GROUP_FILTER=(gidNumber=*)

# Write a POSIX gidNumber on new groups. Requires the RFC2307/IDMU schema
# extension — on a stock AD this fails with an object class violation (LDAP
# error 65). Check before enabling:
#   ldapsearch ... "(&(objectClass=group)(gidNumber=*))" dn | grep -c ^dn:
#AD_WRITE_GID_NUMBER=false


# --- AD writes ----------------------------------------------------------------
#
# AD_WRITE_ENABLED=true is sufficient on its own. Everything below is optional
# narrowing.
#
# With writes on, ACTIVE DIRECTORY IS THE AUTHORITY for who may change what.
# The app stops applying its own admin-group gate (see ADMIN_GROUP above) and
# lets attempts through to the directory, which accepts or refuses them. A
# service account without rights gets LDAP code 50 back, surfaced as a 403
# carrying the directory's own message:
#
#   {"error":"Directory server rejected the operation",
#    "detail":"Insufficient Access Rights","ldapCode":50,
#    "hint":"The bind account lacks permission to write here."}
#
# That is the intended answer, not a misconfiguration — AD's ACLs are managed
# elsewhere and are the real boundary. Note GROUPS_BASE_DN is still where new
# groups get created, so point it at the right OU when it matters.

# Master switch. While unset or false, backend.writable is false and every
# mutating route returns 501.
#AD_WRITE_ENABLED=true

# OPTIONAL. When set, writes are refused unless the target DN is a suffix match
# against one of these subtrees — a local guardrail in front of AD's own ACLs,
# useful when the service account is more privileged than this app should be.
# Unset means no app-side restriction; the directory decides alone.
#
# SEPARATE MULTIPLE DNs WITH ';' — NOT COMMAS. A comma is part of a DN, so
# comma-separating them splits one DN into fragments, and a fragment such as
# "DC=edu" would authorise writes across the entire directory. The app refuses
# to start on an entry that is not a full DN, but do not rely on that.
#AD_ALLOWED_OUS=OU=Groups,DC=example,DC=edu;OU=Projects,DC=example,DC=edu

# Never modified or deleted, whatever the request says. Plain names, matched
# case-insensitively against cn and sAMAccountName. Commas separate these,
# since they are names rather than DNs.
#AD_PROTECTED_NAMES=Domain Admins,Enterprise Admins,Schema Admins

# Refuse to write over a non-TLS connection. Defaults to true. Setting it false
# is the deliberate acknowledgement that credentials and changes travel in the
# clear.
#AD_REQUIRE_TLS=true


# =============================================================================
# NSS backend (DIRECTORY_BACKEND=nss) — read-only
# =============================================================================
#
# Resolves through getent(1), so the same code reads /etc/passwd on a dev box
# and Active Directory on an SSSD-joined host, with no LDAP credentials.
#
# Constraints: Unix groups do not nest, so membership is always flat. There is
# no managedBy — delegation uses a naming convention instead. And SSSD ships
# enumerate=false for AD providers, so substring search returns little or
# nothing; exact-name lookup is always attempted as well so full account names
# still work.

# Members of "<group><suffix>" may manage "<group>".
#NSS_ADMIN_SUFFIX=-adm

# Only surface groups with this prefix, hiding per-user private groups.
#NSS_GROUP_PREFIX=

# Hide system accounts and the nobody/nogroup sentinels at 65534.
#NSS_MIN_UID=1000
#NSS_MIN_GID=1000
#NSS_MAX_ID=65000
