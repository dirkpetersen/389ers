# 389 DS installation directory
/install/

# Build artifacts
/node_modules/
/dist/
/.next/
/out/
/build/

# Environment and config
.env
.env.local
*.local
config/config.yaml
.ldappass
config/config.ad.yaml
config/config.*.yaml
!config/*.yaml.example

# Persisted login sessions (bearer credentials — never commit)
/.sessions/

# Logs
*.log
permissions-changes.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
/tmp/
*.tmp

# LDIF exports contain real directory data (names, email addresses) and must
# never be committed — this repository is public. Only the synthetic bootstrap
# fixture is allowed through; do not broaden this to !scripts/*.ldif.
*.ldif
!scripts/init-ldap.ldif

# Named explicitly as well: a real AD export of live accounts. Keep this entry
# even though *.ldif already covers it, so the exclusion survives any future
# loosening of the glob above.
ad-users-export.ldif
scripts/ad-users-export.ldif

# Rust/Cargo
target/
Cargo.lock

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/

# Node
npm-debug.log*
yarn-debug.log*
yarn-error.log*
